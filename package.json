  "dependencies": {
    "@assistant-ui/react": "0.10.30",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "gsap": "^3.12.2",
    "lucide-react": "^0.544.0",
    "ogl": "^1.0.11",
